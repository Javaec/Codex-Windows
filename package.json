{
  "name": "codex-windows-runner",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:runner": "tsc -p tsconfig.json",
    "build:lite": "node scripts/node/run.js build -ProfileName lite -NoLaunch",
    "build:repack": "npm run build:lite",
    "verify:lite": "node scripts/node/run.js verify",
    "smoke:lite": "node scripts/node/run.js smoke -ProfileName lite",
    "build:forge": "node scripts/node/run.js build -ProfileName forge -NoLaunch",
    "launch:forge": "npm run build:runner && electron ./codex-forge/electron/main.js",
    "test:forge": "npm run build:runner && node scripts/node/forge-launcher.js --print-state && node scripts/node/forge-runtime.js sources && node ./shared/codex-mod-loader/build-compatibility-matrix.mjs && node ./shared/patch-pack/preflight.mjs --snapshot-label Codex-11012.dmg --app-version 26.305.950 --build-number 863 && electron ./codex-forge/electron/main.js --smoke",
    "build:portable:lite": "node scripts/node/run.js build -ProfileName lite -NoLaunch",
    "build:portable:forge": "node scripts/node/run.js build -ProfileName forge -NoLaunch",
    "forge:electron": "npm run build:runner && electron ./codex-forge/electron/main.js",
    "forge:electron:devtools": "npm run build:runner && electron ./codex-forge/electron/main.js --devtools",
    "forge:electron:smoke": "npm run build:runner && electron ./codex-forge/electron/main.js --smoke",
    "forge:runtime:list": "npm run build:runner && node scripts/node/forge-runtime.js list",
    "forge:runtime:sources": "npm run build:runner && node scripts/node/forge-runtime.js sources",
    "forge:runtime:capture": "npm run build:runner && node scripts/node/forge-runtime.js capture-current",
    "forge:runtime:import-official": "npm run build:runner && node scripts/node/forge-runtime.js import-official",
    "forge:runtime:activate-repo-dist": "npm run build:runner && node scripts/node/forge-runtime.js activate-repo-dist",
    "forge:state": "npm run build:runner && node scripts/node/forge-launcher.js --print-state",
    "runner": "node scripts/node/run.js",
    "verify:runner": "node scripts/node/run.js verify",
    "smoke:runner": "node scripts/node/run.js smoke -ProfileName lite",
    "smoke:runner:forge": "node scripts/node/run.js smoke -ProfileName forge -SmokeLanes default,with-mods",
    "smoke:runner:auth": "node scripts/node/run.js smoke -ProfileName forge -SmokeAuthStage -SmokeAuthLanes with-mods -SmokeUserDataSeed %APPDATA%\\Codex -SmokeCodexHomeSeed %USERPROFILE%\\.codex",
    "smoke:runner:daily": "node scripts/node/run.js smoke -ProfileName forge -SmokeAuthStage -SmokeLanes default,with-mods -SmokeUserDataSeed %APPDATA%\\Codex -SmokeCodexHomeSeed %USERPROFILE%\\.codex",
    "mods:compatibility-matrix": "node ./shared/codex-mod-loader/build-compatibility-matrix.mjs",
    "audit:runner": "node scripts/node/run.js audit",
    "contention:runner": "node scripts/node/run.js contention",
    "patch-pack:preflight": "node ./shared/patch-pack/preflight.mjs",
    "patch-pack:preflight:10711": "node ./shared/patch-pack/preflight.mjs --snapshot-label Codex-10711.dmg --app-version 26.303.1606 --build-number 806",
    "patch-pack:preflight:11012": "node ./shared/patch-pack/preflight.mjs --snapshot-label Codex-11012.dmg --app-version 26.305.950 --build-number 863",
    "orchestrator:migration:bridge": "node ./orchestrator-deobf/dist/migration/codex-version-bridge.js",
    "orchestrator:migration:enforce-size-budget": "node ./orchestrator-deobf/dist/migration/enforce-generated-size-budget.js",
    "orchestrator:daily:migrate:10711": "node ./orchestrator-deobf/dist/migration/daily-migrate-10711.js",
    "orchestrator:naming-memory:compact": "node ./orchestrator-deobf/dist/naming/compact-naming-memory-store.js",
    "build:single-exe": "node scripts/node/run.js build -ProfileName lite -SingleExe -NoLaunch -Reuse"
  },
  "devDependencies": {
    "@types/node": "^22.19.10",
    "electron": "^40.8.0",
    "typescript": "^5.9.3"
  }
}
