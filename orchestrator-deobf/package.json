{
  "name": "orchestrator-deobf",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "description": "Stage-based orchestrator for decompile/deobfuscation toolchain",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migration:bridge": "node dist/migration/codex-version-bridge.js",
    "daily:migrate:10711": "node dist/migration/daily-migrate-10711.js",
    "patch-pack:preflight": "node ../shared/patch-pack/preflight.mjs",
    "patch-pack:preflight:10711": "node ../shared/patch-pack/preflight.mjs --snapshot-label Codex-10711.dmg --app-version 26.303.1606 --build-number 806",
    "patch-pack:test:mod-conflict": "node ../shared/patch-pack/test-mod-conflict.mjs",
    "regression:suite": "node dist/regression/run-regression-suite.js",
    "regression:calibrate": "node dist/regression/auto-calibrate.js",
    "regression:cycles": "node dist/regression/run-regression-cycles.js",
    "manual-sync:export": "node dist/manual-sync/export-from-manual.js",
    "manual-sync:validate": "node dist/manual-sync/validate-contracts.js",
    "manual-sync:migrate": "node dist/manual-sync/migrate-manual-sync.js",
    "manual-sync:roundtrip": "node dist/manual-sync/roundtrip-check.js",
    "manual-sync:bootstrap": "node dist/manual-sync/bootstrap-manual-project.js",
    "manual-sync:hot-rescue": "node dist/manual-sync/manual-hot-rescue.js",
    "manual-sync:select-hot": "node dist/manual-sync/select-hot-refactorability.js",
    "manual-sync:quarantine-imports": "node dist/manual-sync/quarantine-hot-imports.js",
    "manual-sync:refactor-top-hot": "node dist/manual-sync/refactor-top-hot-manual.js",
    "manual-sync:batch": "node dist/manual-sync/manual-batch-cycle.js"
  },
  "devDependencies": {
    "@types/node": "^22.19.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@electron/asar": "^4.0.1",
    "@wakaru/cli": "^0.0.10",
    "deobfuscator": "^2.4.5",
    "js-deobfuscator": "^1.1.7",
    "webcrack": "^2.15.1"
  }
}
