{
  "version": 1,
  "genericPathSegments": [
    "types",
    "utils",
    "index",
    "common",
    "shared"
  ],
  "genericPathAllowlist": [
    "index.html",
    "src/index.css",
    "src/types.ts",
    "src/vite-env.d.ts",
    "src/env.d.ts"
  ],
  "domainSourceRoots": [
    "src/main/lib/",
    "src/renderer/features/",
    "src/services/",
    "src-tauri-adapter/"
  ],
  "allowedSourceFiles": [
    "src/main.tsx",
    "src/app.tsx",
    "src/index.css",
    "src/types.ts",
    "src/vite-env.d.ts",
    "src/env.d.ts"
  ],
  "forbiddenTechnicalPrefixes": [
    "src/chunks-ts/",
    "src/runtime/",
    "src/services/store/runtime/",
    "src/services/store-sources/"
  ],
  "forbiddenPathSegments": [
    "runtime",
    "chunks",
    "chunk",
    "artifacts",
    "sources",
    "bridge",
    "bridges",
    "vendor"
  ],
  "archetypePathRules": [
    {
      "root": "src/main/",
      "regex": "^src/main/lib/[^/]+/.+\\.tsx?$",
      "description": "main layer path must match src/main/lib/<family>/*"
    },
    {
      "root": "src/renderer/",
      "regex": "^src/renderer/features/[^/]+/.+\\.tsx?$",
      "description": "renderer layer path must match src/renderer/features/<family>/*"
    },
    {
      "root": "src/services/",
      "regex": "^src/services/[^/]+/.+\\.tsx?$",
      "description": "services layer path must match src/services/<family>/*"
    },
    {
      "root": "src-tauri-adapter/",
      "regex": "^src-tauri-adapter/[^/]+/.+\\.tsx?$",
      "description": "tauri layer path must match src-tauri-adapter/<family>/*"
    }
  ],
  "hotFileLimits": {
    "targetMin": 5,
    "targetMax": 10,
    "defaults": {
      "maxLines": 2400,
      "maxNamespaceImports": 8,
      "minLiftedCoverage": 0.82
    },
    "overrides": [
      {
        "pattern": "src/services/store/store-state-quality-*.ts",
        "maxLines": 4200,
        "maxNamespaceImports": 8,
        "minLiftedCoverage": 0.84
      },
      {
        "pattern": "src/services/store/store-state-g*.ts",
        "maxLines": 3400,
        "maxNamespaceImports": 8,
        "minLiftedCoverage": 0.85
      },
      {
        "pattern": "src/services/service/service-run*.ts",
        "maxLines": 2600,
        "maxNamespaceImports": 8,
        "minLiftedCoverage": 0.86
      },
      {
        "pattern": "src/renderer/features/store/store-path-quality-*.ts",
        "maxLines": 2600,
        "maxNamespaceImports": 9,
        "minLiftedCoverage": 0.82
      }
    ]
  }
}
