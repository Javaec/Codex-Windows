{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manual Sync Contracts v2",
  "definitions": {
    "symbolFingerprint": {
      "type": "object",
      "required": [
        "version",
        "role",
        "apiShape",
        "mutationProfile",
        "parameterCount",
        "incomingBucket",
        "outgoingBucket",
        "stateTokens",
        "callTokens"
      ],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "minLength": 1 },
        "apiShape": { "type": "string", "minLength": 1 },
        "mutationProfile": { "type": "string", "minLength": 1 },
        "parameterCount": { "type": "integer", "minimum": 0 },
        "incomingBucket": { "type": "integer", "minimum": 0 },
        "outgoingBucket": { "type": "integer", "minimum": 0 },
        "stateTokens": { "type": "array", "items": { "type": "string" } },
        "callTokens": { "type": "array", "items": { "type": "string" } }
      }
    },
    "symbolNameOverride": {
      "type": "object",
      "required": ["symbolKey", "preferredName", "confidence", "provenance", "updatedAtIso"],
      "properties": {
        "symbolKey": { "type": "string", "minLength": 1 },
        "preferredName": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "string" },
        "provenance": { "type": "string", "minLength": 1 },
        "updatedAtIso": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "symbolFingerprint": { "$ref": "#/definitions/symbolFingerprint" }
      }
    },
    "modulePathOverride": {
      "type": "object",
      "required": ["symbolKey", "filePath", "confidence", "provenance", "updatedAtIso"],
      "properties": {
        "symbolKey": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "layer": { "type": "string", "enum": ["main", "renderer", "services", "tauri"] },
        "archetype": { "type": "string", "enum": ["hook", "service", "ui", "transport", "store"] },
        "topic": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "string" },
        "provenance": { "type": "string", "minLength": 1 },
        "updatedAtIso": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "symbolFingerprint": { "$ref": "#/definitions/symbolFingerprint" }
      }
    },
    "moduleSurfaceOverride": {
      "type": "object",
      "required": [
        "moduleFilePath",
        "ownerLayer",
        "exportSurface",
        "symbolKeys",
        "confidence",
        "provenance",
        "updatedAtIso"
      ],
      "properties": {
        "moduleFilePath": { "type": "string", "minLength": 1 },
        "ownerLayer": { "type": "string", "enum": ["main", "renderer", "services", "tauri"] },
        "archetype": { "type": "string", "enum": ["hook", "service", "ui", "transport", "store"] },
        "exportSurface": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "symbolKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "string" },
        "provenance": { "type": "string", "minLength": 1 },
        "updatedAtIso": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" }
      }
    },
    "symbolNameOverrideModel": {
      "type": "object",
      "required": ["contractVersion", "migrationVersion", "generatedAtIso", "overrides"],
      "properties": {
        "contractVersion": { "type": "integer", "const": 2 },
        "migrationVersion": { "type": "integer", "const": 1 },
        "generatedAtIso": { "type": "string", "minLength": 1 },
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/definitions/symbolNameOverride" }
        }
      }
    },
    "modulePathOverrideModel": {
      "type": "object",
      "required": ["contractVersion", "migrationVersion", "generatedAtIso", "overrides"],
      "properties": {
        "contractVersion": { "type": "integer", "const": 2 },
        "migrationVersion": { "type": "integer", "const": 1 },
        "generatedAtIso": { "type": "string", "minLength": 1 },
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/definitions/modulePathOverride" }
        }
      }
    },
    "moduleSurfaceOverrideModel": {
      "type": "object",
      "required": ["contractVersion", "migrationVersion", "generatedAtIso", "overrides"],
      "properties": {
        "contractVersion": { "type": "integer", "const": 2 },
        "migrationVersion": { "type": "integer", "const": 1 },
        "generatedAtIso": { "type": "string", "minLength": 1 },
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/definitions/moduleSurfaceOverride" }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/symbolNameOverrideModel" },
    { "$ref": "#/definitions/modulePathOverrideModel" },
    { "$ref": "#/definitions/moduleSurfaceOverrideModel" }
  ]
}
