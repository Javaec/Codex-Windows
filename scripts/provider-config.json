{
  "provider": {
    "id": "codex",
    "name": "OpenAI",
    "wireApi": "responses",
    "supportsWebsockets": false
  },
  "defaults": {
    "model": "gpt-5.4",
    "model_context_window": 270000,
    "model_auto_compact_token_limit": 200000,
    "model_reasoning_effort": "high",
    "personality": "pragmatic",
    "approval_policy": "never",
    "sandbox_mode": "danger-full-access"
  }
}
